# Dependensi
node_modules/

# Berkas sistem
.DS_Store
Thumbs.db
desktop.ini

# Cache deploy Firebase (dibuat ulang setiap deploy)
.firebase/

# Editor
.vscode/
.idea/
*.swp

# Log & sementara
*.log
tmp/
.cache/

# Berkas DICOM pribadi — jangan pernah commit data pasien asli.
# Folder contoh-dicom/ berisi phantom sintetis dan sengaja dilacak.
*.dcm
!contoh-dicom/*.dcm

# Seri volumetrik hasil `node tools/buat-contoh.js` — puluhan MB dan
# bisa dibuat ulang identik kapan saja, jadi tidak perlu dilacak.
contoh-dicom/volume/

# Berkas contoh dari internet hasil `node tools/unduh-contoh.js` —
# milik pihak lain, jadi tidak diredistribusikan lewat repo ini.
contoh-dicom/unduhan/

# Seri volumetrik dari TCIA hasil `node tools/unduh-volume.js` — ratusan MB,
# milik pihak lain, dan sebagian citra pasien sungguhan. Jangan pernah dilacak.
contoh-dicom/tcia/
# Atlas anatomi contoh hasil `node tools/buat-atlas.js` — dibangkitkan
# deterministik dari rumus, jadi bisa dibuat ulang identik kapan saja.
contoh-dicom/atlas/

# Media hasil bangkitan untuk video showreel — bisa dibuat ulang dari
# skrip di video/, dan ukurannya megabita. Skripnya sendiri dilacak.
video/potongan/
video/tangkapan/
video/tmp/

# Video akhir hasil `node video/susun.js` — puluhan megabita dan bisa
# disusun ulang dari tangkapan + klip kapan saja.
video/*.mp4
